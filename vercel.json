{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "crons": [
    { "path": "/api/cron", "schedule": "30 5 * * *" },
    { "path": "/api/cron", "schedule": "30 6 * * *" },
    { "path": "/api/cron", "schedule": "30 19 * * *" },
    { "path": "/api/cron", "schedule": "30 20 * * *" },
    { "path": "/api/cron", "schedule": "0 8 * * 0" },
    { "path": "/api/cron", "schedule": "0 9 * * 0" }
  ]
}
