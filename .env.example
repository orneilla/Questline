# Base Postgres (Neon). Sur Vercel, utiliser l'URL « pooled ».
DATABASE_URL="postgresql://utilisateur:motdepasse@ep-xxx.eu-central-1.aws.neon.tech/questline?sslmode=require"

# Mot de passe unique de l'application.
APP_PASSWORD="a-changer"

# Facultatif : clé de signature du cookie de session.
# Sans valeur, APP_PASSWORD est utilisé (changer le mot de passe déconnecte alors les appareils).
SESSION_SECRET=""

# Facultatif : fuseau de référence pour le découpage des journées.
FUSEAU_HORAIRE="Europe/Paris"
